{
    "name": "alveby/atrium-faq",
    "description": "Questions and answers for Atrium: categories, languages, sites and FAQPage structured data",
    "type": "atrium-module",
    "license": "MIT",
    "homepage": "https://github.com/AlveBy/atrium",
    "support": {
        "issues": "https://github.com/AlveBy/atrium/issues",
        "source": "https://github.com/AlveBy/atrium"
    },
    "keywords": [
        "laravel",
        "admin",
        "cms",
        "faq",
        "schema.org",
        "multisite",
        "i18n"
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "alveby/atrium": "^0.1"
    },
    "require-dev": {
        "alveby/atrium-theme": "^0.1",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.5"
    },
    "suggest": {
        "alveby/atrium-theme": "Draws the FAQ page on the site"
    },
    "autoload": {
        "psr-4": {
            "Atrium\\Faq\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atrium\\Faq\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Atrium\\Faq\\FaqServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
